{
  "name": "ROS 2 · Curso práctico",
  "build": {"dockerfile": "Dockerfile", "context": ".."},
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {"password": "codespaces"}
  },
  "hostRequirements": {"cpus": 4, "memory": "16gb", "storage": "32gb"},
  "runArgs": ["--shm-size=1g"],
  "containerEnv": {
    "ROS_DOMAIN_ID": "42",
    "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "QT_X11_NO_MITSHM": "1"
  },
  "forwardPorts": [6080],
  "portsAttributes": {"6080": {"label": "Escritorio ROS · noVNC", "onAutoForward": "notify"}},
  "postCreateCommand": "bash scripts/setup.sh",
  "customizations": {"vscode": {
    "extensions": ["ms-python.python", "ms-vscode.cpptools"],
    "settings": {"terminal.integrated.defaultProfile.linux": "bash", "files.exclude": {"**/__pycache__": true}}
  }}
}
