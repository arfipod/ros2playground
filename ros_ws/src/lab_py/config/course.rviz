Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Frame Rate: 15
    Background Color: 32; 36; 42
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Robot y obstáculos
      Enabled: true
      Topic:
        Value: /scene
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Size (m): 0.04
      Style: Points
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Vista superior
      Target Frame: odom
      Scale: 70
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1100
  Height: 750
